{
  "name": "church-slide-manager",
  "version": "1.0.0",
  "description": "Church Slide Manager — Aplikasi manajemen slide ibadah",
  "main": "electron/main.js",
  "author": {
    "name": "Church Slide Manager",
    "email": "admin@church.local"
  },
  "scripts": {
    "build:client": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install",
    "electron:dev": "npm run build:client && electron .",
    "dist:mac:arm64": "npm run build:client && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build:client && electron-builder --mac --x64",
    "dist:mac": "npm run build:client && electron-builder --mac --arm64",
    "dist:win": "npm run build:client && electron-builder --win --x64",
    "dist:all": "npm run build:client && electron-builder --mac --arm64 && electron-builder --mac --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.church.slide-manager",
    "productName": "Church Slide Manager",
    "copyright": "Copyright © 2025",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**"
    ],
    "files": [
      "electron/**",
      "server/**",
      "client/dist/**",
      "node_modules/**",
      "!node_modules/.cache/**",
      "!server/node_modules/**",
      "!server/data/**",
      "!client/src/**",
      "!client/node_modules/**",
      "!**/*.log",
      "!**/nodemon*/**"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "Church Slide Manager",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
